# Banco (Turso / libSQL)
TURSO_DATABASE_URL=libsql://exemplo.turso.io
TURSO_AUTH_TOKEN=

# Validação do sasi-token da URL. Sem isso, qualquer token é recusado e só o
# bypass de host local funciona.
AUTH_USER_ENDPOINT=

# --- Atividades do CGC (API SASI / Bone) ---

# Token da API SASI usado em desenvolvimento, quando não há sasi-token na URL.
# Criado em POST /provider/api-tokens com escopo READ_MESSAGES.
# Em produção o token vem do ?sasi-token= e esta variável não é necessária.
SASI_API_TOKEN=

# Opcionais — os defaults já apontam para a API de produção.
# SASI_API_BASE_URL=https://api.bone.sasi.io
# SASI_API_TIMEOUT_MS=15000

# Teto de mensagens lidas por consulta quando o grupo roteia por campo do
# formulário. A API não filtra por conteúdo de formulário, então a varredura é
# feita no servidor.
# SASI_CGC_SCAN_CAP=500

# Nomes dos campos do formulário, caso sejam renomeados no app SASI.
# SASI_CGC_FIELD_GROUP=selecione_time
# SASI_CGC_FIELD_PRIORITY=prioridades
# SASI_CGC_FIELD_DEADLINE=prazo_de_entrega
# SASI_CGC_FIELD_DESCRIPTION=descreva
