# Banco (Turso / libSQL)
TURSO_DATABASE_URL=libsql://exemplo.turso.io
TURSO_AUTH_TOKEN=

# Validação do sasi-token. Sem isso, qualquer token é recusado — em todo
# ambiente, inclusive localhost (não existe bypass de host local).
AUTH_USER_ENDPOINT=

# URL do sistema cgc-atividades (server-only — nunca exposta ao navegador).
# Usada pelo proxy de /api/controle/cgc* pra buscar dados do CGC.
# O perfil "dev" do docker-compose sobrescreve esse valor pra
# http://host.docker.internal:3001 dentro do container (environment: tem
# precedência sobre env_file:) — se editar aqui e o comportamento não mudar
# rodando `docker compose --profile dev`, é esse override, não um cache.
CGC_APP_URL=http://localhost:3001

# Segredo compartilhado com o cgc-atividades (mesmo valor nos dois
# .env.local) que autentica as chamadas do proxy de /api/controle/cgc*,
# enviado no header x-controle-secret. Sem essa env var, o proxy recusa de
# propósito (500) em vez de chamar o cgc-atividades sem credencial.
CONTROLE_PROXY_SECRET="65c92eb47707ba5dbfc83eed10a91566e8133b275b9f634fc18732c052b90844"
