# Banco (Turso / libSQL)
TURSO_DATABASE_URL=libsql://exemplo.turso.io
TURSO_AUTH_TOKEN=

# Validação do sasi-token da URL. Sem isso, qualquer token é recusado e só o
# bypass de host local funciona.
AUTH_USER_ENDPOINT=

# URL do sistema sasi-cgc (server-only — nunca exposta ao navegador).
# Usada pelo proxy de /api/controle/cgc* pra buscar dados do CGC.
# O perfil "dev" do docker-compose sobrescreve esse valor pra
# http://host.docker.internal:3001 dentro do container (environment: tem
# precedência sobre env_file:) — se editar aqui e o comportamento não mudar
# rodando `docker compose --profile dev`, é esse override, não um cache.
CGC_APP_URL=http://localhost:3001
